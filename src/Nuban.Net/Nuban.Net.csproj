<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Nuban</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Nuban.Net</PackageId>
    <Version>0.1.0</Version>
    <Title>Nuban.NET</Title>
    <Authors>Israel Iyonsi</Authors>
    <Copyright>Copyright (c) 2026 Israel Iyonsi</Copyright>
    <Description>Validate Nigerian NUBAN bank account numbers in .NET. CBN check-digit verification and structure checks for the 10-digit NUBAN format. Zero external dependencies, no bundled bank registry.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/IsraelIyonsi/Nuban.NET</RepositoryUrl>
    <PackageProjectUrl>https://github.com/IsraelIyonsi/Nuban.NET</PackageProjectUrl>
    <PackageTags>nuban;nigeria;bank;account-number;cbn;fintech;validation;check-digit;banking</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See https://github.com/IsraelIyonsi/Nuban.NET/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nuban.Net.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
